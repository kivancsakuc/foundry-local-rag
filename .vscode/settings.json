{
  // Point Python at the project venv so IntelliSense, linting and the test
  // explorer all resolve foundry_local_sdk and streamlit without activation.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,

  "python.testing.unittestEnabled": true,
  "python.testing.pytestEnabled": false,
  "python.testing.unittestArgs": [
    "-v",
    "-s",
    "${workspaceFolder}/path-c-sqlite",
    "-p",
    "test_*.py"
  ],

  // path-c modules import each other flat (import config, import rag), so the
  // language server needs that folder on the path to resolve them.
  "python.analysis.extraPaths": ["${workspaceFolder}/path-c-sqlite"],

  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/node_modules": true,
    "**/package-lock.json": true,
    "**/data": true
  },

  "[python]": {
    "editor.rulers": [88]
  },
  "[javascript]": {
    "editor.rulers": [100]
  },
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.rulers": [90]
  },

  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true
}
